{
  "name": "browser-rag",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node scripts/prepare-offline.mjs --runtime-only && ng serve --port 4400",
    "build": "ng build && node scripts/prepare-offline.mjs",
    "preview": "node scripts/serve.mjs",
    "build:index": "node pipeline/build-index.ts",
    "verify:recall": "node pipeline/verify-recall.ts",
    "test": "node --experimental-strip-types --test pipeline/*.test.ts",
    "typecheck:pipeline": "tsc -p pipeline/tsconfig.json"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@electric-sql/pglite": "0.3.15",
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "type": "module"
}
